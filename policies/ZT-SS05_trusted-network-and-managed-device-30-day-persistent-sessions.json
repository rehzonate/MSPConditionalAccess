{
  "displayName": "[ZT-SS05] Trusted Network and Managed Device: 30-Day Persistent Sessions",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "excludeGroups": [
        "{{BREAK_GLASS_GROUP_ID}}"
      ],
      "includeUsers": [
        "All"
      ]
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "clientAppTypes": [
      "browser",
      "mobileAppsAndDesktopClients"
    ],
    "platforms": {
      "includePlatforms": [
        "all"
      ],
      "excludePlatforms": [
        "android",
        "iOS",
        "windowsPhone"
      ]
    },
    "locations": {
      "includeLocations": [
        "AllTrusted"
      ]
    },
    "devices": {
      "deviceFilter": {
        "mode": "include",
        "rule": "device.trustType -eq \"ServerAD\" -or device.trustType -eq \"AzureAD\" -or device.deviceOwnership -eq \"Company\""
      }
    }
  },
  "sessionControls": {
    "signInFrequency": {
      "isEnabled": true,
      "frequencyInterval": "timeBased",
      "value": 30,
      "type": "days",
      "authenticationType": "primaryAndSecondaryAuthentication"
    },
    "persistentBrowser": {
      "isEnabled": true,
      "mode": "always"
    }
  }
}