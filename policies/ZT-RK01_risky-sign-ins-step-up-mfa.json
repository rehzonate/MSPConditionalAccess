{
  "displayName": "[ZT-RK01] Risky Sign-ins: Step-Up MFA",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "excludeGroups": [
        "{{BREAK_GLASS_GROUP_ID}}"
      ],
      "includeGroups": [
        "{{P2_RISK_USERS_GROUP_ID}}"
      ]
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "clientAppTypes": [
      "all"
    ],
    "signInRiskLevels": [
      "high",
      "medium"
    ]
  },
  "grantControls": {
    "operator": "OR",
    "authenticationStrength": {
      "id": "00000000-0000-0000-0000-000000000002"
    }
  },
  "sessionControls": {
    "signInFrequency": {
      "isEnabled": true,
      "frequencyInterval": "everyTime",
      "authenticationType": "primaryAndSecondaryAuthentication"
    }
  }
}