{
  "displayName": "[ZT-DV01] Windows: Managed Devices Only",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "excludeGroups": [
        "{{BREAK_GLASS_GROUP_ID}}"
      ],
      "includeUsers": [
        "All"
      ],
      "excludeGuestsOrExternalUsers": {
        "guestOrExternalUserTypes": "internalGuest,b2bCollaborationGuest,b2bCollaborationMember,b2bDirectConnectUser,otherExternalUser,serviceProvider",
        "externalTenants": {
          "@odata.type": "#microsoft.graph.conditionalAccessAllExternalTenants",
          "membershipKind": "all"
        }
      }
    },
    "applications": {
      "includeApplications": [
        "Office365"
      ]
    },
    "clientAppTypes": [
      "browser",
      "mobileAppsAndDesktopClients"
    ],
    "platforms": {
      "includePlatforms": [
        "all"
      ],
      "excludePlatforms": [
        "android",
        "iOS",
        "macOS"
      ]
    },
    "locations": {
      "includeLocations": [
        "All"
      ],
      "excludeLocations": [
        "{{OFFICE_NAMED_LOCATION_ID}}"
      ]
    },
    "devices": {
      "deviceFilter": {
        "mode": "exclude",
        "rule": "device.trustType -eq \"ServerAD\" -or device.trustType -eq \"AzureAD\" -or device.deviceOwnership -eq \"Company\""
      }
    }
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}